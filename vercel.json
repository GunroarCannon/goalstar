{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "css/**,js/**,assets/**,index.html,home.html"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/home",
      "destination": "/home.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
