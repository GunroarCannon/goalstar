{
  "cleanUrls": true,
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/home",
      "destination": "/home.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
