# ---- Server Port ----
PORT=8000

# ---- Walrus Memory on Mainnet (get at https://memory.walrus.xyz) ----
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=goalstar-workflows

# ---- Tatum (Sui Mainnet gRPC gateway + Walrus Storage API) ----
# Free tier: 3 requests/sec. Without this key, certificates are disabled.
TATUM_API_KEY=
# Optional override; defaults to sui-mainnet-grpc.gateway.tatum.io:443
# TATUM_SUI_GRPC_HOST=

# ---- LLM Dreamer (Groq fast inference) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
