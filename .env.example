# ---- Server Port ----
PORT=8000

# ---- Walrus Memory on Mainnet (get at https://memory.walrus.xyz) ----
MEMWAL_ACCOUNT_ID=
MEMWAL_PRIVATE_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=goalstar-workflows

# ---- Tatum RPC & Gateway (Sui Mainnet) ----
# Free tier: 3 Requests/sec
TATUM_API_KEY=
TATUM_DEVNET_API_KEY=
TATUM_SUI_RPC_URL=https://api.tatum.io/v3/blockchain/node/sui-mainnet

# ---- LLM Dreamer (Groq fast inference) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
